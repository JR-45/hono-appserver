# syntax=docker.io/docker/dockerfile-upstream:1.23.0
# check=error=true

ARG BUN_VERSION=1.3.13

# Stage 1: Dependencies installieren und Bun-Binary bereitstellen
# Debian-Variante (glibc) statt Alpine (musl), da das finale
# Chainguard-Image glibc verwendet.
FROM oven/bun:${BUN_VERSION} AS deps

WORKDIR /app

RUN --mount=type=bind,source=package.json,target=package.json \
  --mount=type=bind,source=bun.lock,target=bun.lock \
  --mount=type=cache,target=/root/.bun <<EOF
  bun install --frozen-lockfile --production
EOF

# Stage 2: Finales gehaertetes Image
# Minimales Chainguard-Image mit glibc, ohne Shell und Package Manager.
# User "nonroot" (UID 65532) ist im Image bereits vorhanden.
FROM cgr.dev/chainguard/glibc-dynamic:latest AS final

WORKDIR /opt/app

# Bun-Binary und App-Dateien aus Stage 1 kopieren
COPY --from=deps /usr/local/bin/bun /usr/local/bin/bun
COPY --chown=nonroot:nonroot package.json ./
COPY --from=deps --chown=nonroot:nonroot /app/node_modules ./node_modules
COPY --chown=nonroot:nonroot src ./src

USER nonroot

EXPOSE 3000
EXPOSE 3030

ENV BUN_BIND_HOST=0.0.0.0

ENTRYPOINT ["/usr/local/bin/bun", "run", "src/index.mts"]