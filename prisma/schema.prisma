/// https://www.prisma.io/docs/orm/reference/prisma-schema-reference
/// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#generator
generator client {
  /// Default ab Prisma 6.18
  /// https://www.prisma.io/docs/orm/prisma-schema/overview/generators#output-splitting-and-importing-types
  /// https://www.prisma.io/blog/why-prisma-orm-generates-code-into-node-modules-and-why-it-ll-change
  /// https://www.prisma.io/blog/rust-free-prisma-orm-is-ready-for-production
  /// https://github.com/prisma/prisma/releases/tag/6.6.0
  /// https://github.com/prisma/prisma/releases/tag/6.16.0
  /// ESM-first
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  /// https://www.prisma.io/docs/orm/reference/preview-features/client-preview-features#currently-active-preview-features
  /// https://github.com/prisma/prisma/releases/tag/5.7.0
  previewFeatures     = ["nativeDistinct", "relationJoins"]
  engineType          = "client"
  /// https://github.com/prisma/prisma/releases/tag/7.3.0
  /// default: "fast"; alternativ: "small"
  /// compilerBuild = "fast"
  /// https://github.com/prisma/prisma/releases/tag/6.12.0
  // importFileExtension = "ts"
}

/// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#datasource
datasource db {
  provider = "postgresql"
  schemas  = ["mitglied"]
}

/// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#datasource
model Mitglied {
  id              Int              @id @default(autoincrement())
  version         Int              @default(0)
  vorname         String
  nachname        String
  email           String           @unique
  /// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#date
  geburtsdatum    DateTime?        @db.Date
  telefonnummer   String?          @unique
  geschlecht      Geschlecht?
  mitgliedsstatus Mitgliedsstatus?
  beitrittsdatum  DateTime?        @db.Date
  /// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#json
  interessen      Json?
  erzeugt         DateTime         @db.Timestamp(6)
  /// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#updatedat
  aktualisiert    DateTime         @updatedAt @db.Timestamp(6)
  ausleihen       Ausleihe[]
  ausweis         Ausweis?

  @@map("mitglied")
  @@schema("mitglied")
}

model Ausweis {
  id                Int      @id @default(autoincrement())
  ausstellungsdatum DateTime @db.Date
  ablaufdatum       DateTime @db.Date
  mitgliedId        Int      @unique @map("mitglied_id")
  /// https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/referential-actions#referential-action-defaults
  mitglied          Mitglied @relation(fields: [mitgliedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ausweis")
  @@schema("mitglied")
}

model Ausleihe {
  id             Int      @id @default(autoincrement())
  ausleihdatum   DateTime @db.Date
  rueckgabedatum DateTime @db.Date
  mitgliedId     Int      @map("mitglied_id")
  /// https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/referential-actions#referential-action-defaults
  mitglied       Mitglied @relation(fields: [mitgliedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([mitgliedId])
  @@map("ausleihe")
  @@schema("mitglied")
}

/// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#enum
enum Geschlecht {
  MAENNLICH
  WEIBLICH
  DIVERS

  @@map("geschlecht")
  @@schema("mitglied")
}

/// https://www.prisma.io/docs/orm/reference/prisma-schema-reference#enum
enum Mitgliedsstatus {
  AKTIV
  INAKTIV
  GESPERRT

  @@map("mitgliedsstatus")
  @@schema("mitglied")
}
