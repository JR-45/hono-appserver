generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["nativeDistinct", "relationJoins"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["mitglied"]
}

model Ausleihe {
  id             Int      @id @default(autoincrement())
  ausleihdatum   DateTime @db.Date
  rueckgabedatum DateTime @db.Date
  mitgliedId     Int      @map("mitglied_id")
  mitglied       Mitglied @relation(fields: [mitgliedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([mitgliedId])
  @@map("ausleihe")
  @@schema("mitglied")
}

model Ausweis {
  id                Int      @id @default(autoincrement())
  ausstellungsdatum DateTime @db.Date
  ablaufdatum       DateTime @db.Date
  mitgliedId        Int      @unique @map("mitglied_id")
  mitglied          Mitglied @relation(fields: [mitgliedId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([mitgliedId])
  @@map("ausweis")
  @@schema("mitglied")
}

model Mitglied {
  id              Int              @id @default(autoincrement())
  version         Int              @default(0)
  vorname         String
  nachname        String
  email           String           @unique
  geburtsdatum    DateTime?        @db.Date
  telefonnummer   String?          @unique
  geschlecht      Geschlecht?
  mitgliedsstatus Mitgliedsstatus?
  beitrittsdatum  DateTime?        @db.Date
  interessen      Json?
  erzeugt         DateTime         @default(now()) @db.Timestamp(6)
  aktualisiert    DateTime         @default(now()) @db.Timestamp(6) @updatedAt
  ausleihen       Ausleihe[]
  ausweis         Ausweis?

  @@index([nachname])
  @@map("mitglied")
  @@schema("mitglied")
}

enum Geschlecht {
  MAENNLICH
  WEIBLICH
  DIVERS

  @@map("geschlecht")
  @@schema("mitglied")
}

enum Mitgliedsstatus {
  AKTIV
  INAKTIV

  @@map("mitgliedsstatus")
  @@schema("mitglied")
}
